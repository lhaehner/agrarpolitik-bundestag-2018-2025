  "cooccurrence_rules": [
    {
      "id": "K1",
      "category": "SR1",
      "label": "Ernährung, Welternährung oder Ernährungssystem und Sicherung",
      "any_a": [
        "L_ernaehrung",
        "L_welternaehrung",
        "L_ernaehrungssystem"
      ],
      "any_b": [
        "L_sichern",
        "L_sicherung",
        "L_sicherstellen",
        "L_sicherstellung"
      ]
    },
    {
      "id": "K2",
      "category": "SR2",
      "label": "Lebensmittel und Versorgung",
      "any_a": [
        "L_lebensmittel",
        "L_nahrungsmittel",
        "L_grundnahrungsmittel"
      ],
      "any_b": [
        "L_versorgung",
        "L_versorgen"
      ]
    },
    {
      "id": "K3",
      "category": "SR3",
      "label": "Benannte Güter und Mangel",
      "any_a": [
        "L_lebensmittel",
        "L_nahrungsmittel",
        "L_grundnahrungsmittel",
        "L_futtermittel",
        "L_duenger",
        "L_duengemittel"
      ],
      "any_b": [
        "L_mangel",
        "L_mangeln"
      ]
    },
    {
      "id": "K4",
      "category": "SR4",
      "label": "Import und Abhängigkeit oder Unabhängigkeit",
      "any_a": [
        "L_import",
        "L_lebensmittelimport",
        "L_nahrungsmittelimport",
        "L_futterimport",
        "L_futtermittelimport",
        "L_getreideimport",
        "L_weizenimport",
        "L_duengerimport",
        "L_duengemittelimport",
