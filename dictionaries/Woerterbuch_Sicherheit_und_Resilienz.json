{
  "schema_version": "sr-closed-forms-1.0",
  "name": "Sicherheit und Resilienz",
  "dimension_id": "sicherheit_resilienz",
  "structure": [
    "categories definiert die Themenkategorien; lexemes enthält die geschlossenen Formen.",
    "direct_rules verbindet einen Direktbegriff mit seiner Kategorie.",
    "cooccurrence_rules verbindet zwei Gruppen von Ausdrücken innerhalb eines Satzes.",
    "local_exclusions maskiert nur die benannten Fundstellen in festgelegten Namen.",
    "Nicht jedes Lexem zählt allein; einige dienen ausschließlich als Satzregelanker.",
    "Die folgenden Erläuterungen beschreiben die Regeln; sie erweitern sie nicht."
  ],
  "description": [
    "Präsenz der benannten Gegenstände im bereits bestimmten Agrar- und Ernährungskorpus.",
    "Neutrale, bejahte, verneinte und hypothetische Thematisierungen zählen."
  ],
  "matching_policy": {
    "unit": "Ein bereits segmentierter Satz je Aufruf.",
    "counting": [
      "Je Satz, Themenbereich und Kategorie höchstens 1.",
      "Mehrere Kategorien und Themenbereiche dürfen im selben Satz zutreffen."
    ],
    "scope": "Direktbegriffe benötigen innerhalb des A&E-Korpus keinen weiteren Lebensmittelbezug.",
    "normalization": [
      "NFKC und casefold; ä/ö/ü zu ae/oe/ue, ß zu ss.",
      "Leerraum vereinheitlichen, Soft-Hyphen entfernen, U+2010/U+2011 zu Bindestrich."
    ],
    "boundaries": [
      "Geschlossene Ganzwort- und Mehrwortformen.",
      "Zusätzliche Komposita und angehängte Bindestrich-Wortteile erzeugen keinen Teiltreffer."
    ],
    "word_forms": [
      "Ausschließlich die ausdrücklich hinterlegten forms-Listen.",
      "Keine Stammregeln, Lemmatisierung oder automatisch ergänzten Formen."
    ],
    "direct_rules": "Eine unmaskierte Fundstelle des lexeme_id genügt.",
    "cooccurrence_rules": [
      "Mindestens ein unmaskierter Ausdruck aus any_a und einer aus any_b im selben Satz.",
      "Reihenfolge und Abstand sind beliebig.",
      "Eine semantische Verknüpfung der beiden Ausdrücke wird nicht zusätzlich geprüft."
    ],
    "exclusions": [
      "Nur die in local_exclusions benannten Fundstellen in festgelegten Namen maskieren.",
      "Weitere Treffer bleiben gültig; kein Ausschluss des gesamten Satzes."
    ],
    "interpretation": [
      "Thematisierung belegt weder eine Krise noch eine sicherheitspolitische Rahmung."
    ]
  },
  "categories": [
    {
      "id": "SR1",
      "label": "Ernährungssicherheit und Ernährungssicherung",
      "nummer": 1
    },
    {
      "id": "SR2",
      "label": "Versorgung, Versorgungssicherung und Vorsorge",
      "nummer": 2
    },
    {
      "id": "SR3",
      "label": "Krisen, Mangel, Knappheit und Engpässe",
      "nummer": 3
    },
    {
      "id": "SR4",
      "label": "Selbstversorgung, Souveränität und Importabhängigkeit",
      "nummer": 4
    },
    {
      "id": "SR5",
      "label": "Resilienz, Krisenfestigkeit und Systemrelevanz",
      "nummer": 5
    }
  ],
